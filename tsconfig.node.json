{
  "compilerOptions": {
    "ts-node": {
      "transpileOnly": true
    },
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["vite.config.ts", "tailwind.config.ts"]
}
